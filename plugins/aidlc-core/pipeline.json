{
  "version": 2,
  "_comment": "Gouvernance du harnais. Ce fichier ne porte plus de registre d'etapes : « quels agents existent » se lit dans les manifestes agent.json des plugins (aidlc.py agents). planned_stages est une feuille de route consultative — elle est affichee par status et pre-remplit scaffold, elle n'execute rien.",
  "maturity_threshold": 4.0,
  "consecutive_runs_to_autonomy": 3,
  "watchdog": {
    "validation_failures_threshold": 5,
    "write_loop_threshold": 6,
    "rerun_threshold": 5,
    "window": 60
  },
  "planned_stages": [
    {
      "id": "design",
      "name": "Design",
      "deliverable": "deliverables/design/spec.md",
      "inputs": ["deliverables/plan/intent.md"],
      "human_role": "Architecte de solution",
      "team": "Architecture"
    },
    {
      "id": "build",
      "name": "Build",
      "deliverable": "deliverables/build/plan.md",
      "inputs": ["deliverables/design/spec.md"],
      "human_role": "Tech Lead",
      "team": "Ingenierie"
    },
    {
      "id": "test",
      "name": "Test",
      "deliverable": "deliverables/test/test-plan.md",
      "inputs": ["deliverables/build/plan.md"],
      "human_role": "QA Lead",
      "team": "Qualite"
    },
    {
      "id": "deploy",
      "name": "Deploy",
      "deliverable": "deliverables/deploy/release-notes.md",
      "inputs": ["deliverables/test/test-plan.md"],
      "human_role": "SRE / Release Manager",
      "team": "Plateforme"
    },
    {
      "id": "maintain",
      "name": "Maintain",
      "deliverable": "deliverables/maintain/ops-report.md",
      "inputs": ["deliverables/deploy/release-notes.md"],
      "human_role": "Ops / Support",
      "team": "Exploitation"
    }
  ]
}
