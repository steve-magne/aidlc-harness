{
  "required_frontmatter": ["stage", "version", "status", "author", "date"],
  "required_sections": [
    "## Contexte",
    "## Capacités et dépendances SI",
    "## Architecture cible",
    "## Options écartées",
    "## Exigences non fonctionnelles",
    "## Risques et mitigations",
    "## Critères d'acceptation",
    "## Hors périmètre",
    "## Sources et références"
  ],
  "min_words": 350,
  "max_words": 2500,
  "forbidden_patterns": [
    "(?i)\\bTODO\\b",
    "(?i)\\bTBD\\b",
    "\\bXXX\\b",
    "(?i)\\blorem\\b",
    "(?i)\\b[àa]\\s+compl[ée]ter\\b",
    "(?i)<[^>\\n]{0,80}\\b[àa]\\s+remplir[^>\\n]{0,80}>"
  ],
  "required_patterns": ["stage:\\s*design"],
  "must_reference_inputs": true,
  "required_input_section": {
    "deliverables/plan/intent.md": "## Contexte"
  },
  "must_not_violate_scope": {
    "section": "## Hors périmètre"
  },
  "min_items_per_section": {
    "## Capacités et dépendances SI": 2,
    "## Options écartées": 1,
    "## Exigences non fonctionnelles": 3,
    "## Risques et mitigations": 2,
    "## Critères d'acceptation": 3
  },
  "proof_of_run": [
    "## Contexte",
    "## Exigences non fonctionnelles",
    "## Critères d'acceptation"
  ],
  "checks_do_not_self_reference": true
}
